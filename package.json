{
  "name": "framegram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "yarn build",
    "format": "prettier --write .",
    "start": "next start",
    "lint": "npx eslint",
    "prepare": "husky",
    "rename-icons": "node scripts/rename-icons.cjs",
    "generate-icons": "pnpm run rename-icons && npx @svgr/cli --icon --out-dir assets/icons/components --jsx-runtime automatic --typescript --ref --memo --replace-attr-values \"#000=currentcolor\"  --replace-attr-values \"#fff=currentcolor\" -- assets/icons/svg && node scripts/replace-color.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint . --fix --no-cache --max-warnings=0",
    "*.{js,jsx,ts,tsx,md,mdx}": "prettier --write"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "next": "16.0.4",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "9.39.1",
    "@storybook/addon-a11y": "10.1.1",
    "@storybook/addon-docs": "10.1.1",
    "@storybook/addon-onboarding": "10.1.1",
    "@storybook/nextjs-vite": "10.1.1",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "10.1.1",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "prettier": "3.7.1",
    "sass": "1.94.2",
    "storybook": "10.1.1",
    "stylelint": "16.26.0",
    "stylelint-scss": "6.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  }
}