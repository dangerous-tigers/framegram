{
  "name": "framegram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "npm run build",
    "format": "prettier --write .",
    "start": "next start",
    "lint": "npx eslint",
    "lint-fix": "pnpm run lint --fix",
    "prepare": "husky",
    "rename-icons": "node scripts/rename-icons.cjs",
    "generate-icons": "pnpm run rename-icons && npx @svgr/cli --icon --out-dir assets/icons/components --jsx-runtime automatic --typescript --ref --memo --replace-attr-values \"#000=currentcolor\"  --replace-attr-values \"#fff=currentcolor\" -- assets/icons/svg && node scripts/replace-color.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:styles": "stylelint \"**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "generate-api": "pnpm openapi-typescript https://inctagram.work/api/v1/swagger-json -o ./shared/api/schema.ts --root-types"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint . --fix --no-cache --max-warnings=0",
    "*.{js,jsx,ts,tsx,md,mdx}": "prettier --write",
    "*.{css,scss}": "stylelint --fix"
  },
  "dependencies": {
    "@dangerous-tigers/framehub-ui-kit": "^1.0.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.0.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/react-date-range": "^1.4.10",
    "clsx": "^2.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "idb": "^8.0.3",
    "konva": "^10.2.0",
    "lodash.debounce": "^4.0.8",
    "motion": "^12.23.26",
    "next": "16.0.4",
    "next-intl": "^4.6.0",
    "openapi-fetch": "^0.15.0",
    "overlayscrollbars": "^2.13.0",
    "overlayscrollbars-react": "^0.5.6",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.1",
    "react-konva": "^19.2.3",
    "react-time-ago": "^7.3.5",
    "rsuite": "^6.1.2",
    "socket.io-client": "^4.8.3",
    "swiper": "^12.0.3",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "10.1.10",
    "@storybook/addon-docs": "10.1.10",
    "@storybook/addon-onboarding": "10.1.10",
    "@storybook/nextjs-vite": "10.1.10",
    "@storybook/react": "10.1.10",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "10.1.10",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.57.0",
    "prettier": "3.7.1",
    "sass": "1.94.2",
    "storybook": "10.1.10",
    "stylelint": "16.26.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "6.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  }
}
